# Copy to .env and fill in values — never commit .env

DB_ROOT_PASSWORD=StrongRootPassword123!
DB_USER=crout_user
DB_PASSWORD=StrongUserPassword123!

JWT_SECRET=your-256-bit-secret-key-change-me
JWT_ISSUER=crout-automations-api
JWT_AUDIENCE=crout-automations-client
JWT_EXPIRY_HOURS=8

HMAC_SECRET=crout-automations-secret-2026

# Comma-separated list of allowed CORS origins.
# REQUIRED in production — the API will return no CORS headers and
# all browser requests will be blocked if this is missing or empty.
# Example: https://automations.crout-holdings.com,https://crout-holdings.com
ALLOWED_ORIGINS=https://automations.crout-holdings.com,https://crout-holdings.com

SMTP_HOST=mail.mailer.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=no_reply@crout-holdings.com
SMTP_PASSWORD=pwd

CONTACT_TO_EMAIL=info@crout-holdings.com
SMTP_FROM_EMAIL=no_reply@crout-holdings.com

N8N_BASE_URL=http://localhost:5678
N8N_APIKEY=your-n8n-api-key-change-me
N8N_WORKSPACEID=your-n8n-workspace-id-change-me
N8N_DEFAULTPROJECTID=your-n8n-default-project-id-change-me

# Base URL used to build Custom Form share links (e.g. https://automations.crout-holdings.com/forms/{token}).
# Defaults to the production SPA origin if unset — override for local/dev environments
# (e.g. http://localhost:4200 when running the Angular dev server against a local API).
APP_BASE_URL=https://automations.crout-holdings.com
# Link validity itself is chosen per-link by the owner (1-365 days, or a 365-day "1 Year"
# preset) at generation time — there is no environment-level default expiry to configure.
#
# NOTE: the Custom Form share-link feature (first unauthenticated, internet-facing endpoint in
# this app) has no feature-flag/environment gate — it is unconditionally enabled everywhere,
# including production, per explicit instruction during local testing. The R12 security review
# is still owed but is no longer a code-enforced gate; see
# openspec/changes/custom-form-share-links/design.md's note on this decision and its risk.